# Local development only. `npm start` requires this explicit opt-out. The
# `start:app-service` launcher instead requires production mode, entra_bff,
# dedicated Azure browser sessions and separate auth/application data accounts.
NOFRIES_REQUIRE_AUTH=false
NOFRIES_DEV_EMAIL=developer@example.com
NOFRIES_ALLOW_HEADERLESS_MUTATIONS=false
# Standalone-only escape hatch. Never enable unless a trusted proxy strips and
# replaces identity headers before traffic reaches this process.
NOFRIES_TRUSTED_AUTH_PROXY=false

# Browser sign-in. Keep `swa` until the same-domain Entra BFF endpoints have
# been deployed, configured and smoke-tested; production cutover uses
# `entra_bff`. Secrets belong only in protected runtime settings/Key Vault.
NOFRIES_BROWSER_AUTH_MODE=swa
NOFRIES_PUBLIC_URL=https://nofries.nz
NOFRIES_ENTRA_TENANT_ID=
NOFRIES_ENTRA_CLIENT_ID=
NOFRIES_ENTRA_CLIENT_SECRET=
NOFRIES_ALLOWED_SUBJECTS=
# Browser roles are also bound to immutable Entra tid:oid subjects. Email and
# UPN values below remain display/legacy-SWA attributes and never grant a BFF
# session a role.
NOFRIES_ADMIN_SUBJECTS=
NOFRIES_SERVICE_OWNER_SUBJECTS=
# Hosted production uses a dedicated private Azure Blob account through the
# website Function App managed identity. It must not share the application-data
# account, and the public connector must have no data access. Memory is local-test only.
NOFRIES_BROWSER_SESSION_STORE=memory
NOFRIES_BROWSER_AUTH_STORAGE_ACCOUNT=
NOFRIES_BROWSER_AUTH_CONTAINER=nofries-browser-auth

# Tenant identity and branding.
NOFRIES_TENANT_NAME=No Fries workspace
NOFRIES_TENANT_SLUG=nofries-workspace
NOFRIES_DEFAULT_TENANT_ID=nofries-workspace

# Legacy SWA access. These email/tenant settings are ignored for entra_bff
# browser authorization and remain only for rollback/local compatibility.
NOFRIES_ALLOWED_TENANT_IDS=
NOFRIES_ALLOW_TENANT_WIDE=false
NOFRIES_ALLOWED_EMAILS=developer@example.com
NOFRIES_PILOT_EMAILS=
NOFRIES_ADMIN_EMAILS=developer@example.com
NOFRIES_SERVICE_OWNER_EMAILS=

# Production persistence.
NOFRIES_STORAGE_PROVIDER=local
NOFRIES_DATA_DIR=.nofries-data
# Prefer AZURE_STORAGE_ACCOUNT_NAME with a managed identity in production.
# The connection string is a local/emergency fallback only.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
NOFRIES_AZURE_CONTAINER=nofries-workspace
NOFRIES_SALES_CONTAINER=nofries-workspace

# Reserved customer-operations rollout declarations. These do not activate a
# runtime path yet; keep them false until the corresponding worker/adapter and
# explicit enforcement are implemented, reviewed and tested.
NOFRIES_HANDOFF_OUTBOX_ENABLED=false
NOFRIES_INTERNAL_DISPATCH_ENABLED=false
NOFRIES_SCHEDULER_ENABLED=false
NOFRIES_CUSTOMER_MASTER_SHADOW_ENABLED=false
NOFRIES_ENTITY_STORE_MODE=blob
NOFRIES_ENTITY_STORE_WRITE_ENABLED=false

# Production service desk. Local development stays fail-closed on the legacy
# deterministic runtime. Production activation is performed only by the manual
# protected cutover after exact provider mappings, credentials, storage,
# customer bindings and signed canary identities have been verified.
NOFRIES_SERVICE_DESK_PROVIDER=mock
NOFRIES_AGENT_RUNTIME=mock
NOFRIES_SERVICE_DESK_STORAGE_PROVIDER=local
NOFRIES_SERVICE_DESK_CONTAINER=nofries-workspace
NOFRIES_SERVICE_DESK_OPERATION_STORAGE_PROVIDER=memory
NOFRIES_SERVICE_DESK_OPERATION_STORAGE_ACCOUNT=
NOFRIES_SERVICE_DESK_OPERATION_STORAGE_CONTAINER=service-desk-operations
# Durable operation receipts back customer/staff status polling. Manual
# provider-absence resolution is service_owner-only, requires two exact negative
# Autotask reads separated by a six-minute quarantine (beyond Autotask's
# documented five-minute execution window), and never
# applies to status_patch. Keep status writes disabled for this release.
NOFRIES_SERVICE_DESK_CONTROLS_SHA256=
NOFRIES_SERVICE_DESK_WRITE_SCOPE=disabled
NOFRIES_SERVICE_DESK_CANARY_STAFF_SUBJECTS=

# Autotask PSA is the production support-ticket source of truth. The Datto RMM
# tenant must use its native Autotask PSA integration so device-originated
# tickets land in the same customer/company boundary. Keep credentials and
# mapping JSON in version-pinned Key Vault references in hosted production.
NOFRIES_AUTOTASK_MODE=disabled
NOFRIES_AUTOTASK_WRITE_ENABLED=false
NOFRIES_AUTOTASK_TENANT_ID=
NOFRIES_AUTOTASK_PROVIDER_SCOPE_ID=
# Stable provider-account identity; do not derive it from a username, secret or
# integration code because credential rotation must preserve operation replay.
NOFRIES_AUTOTASK_PROVIDER_ACCOUNT_ID=
NOFRIES_AUTOTASK_API_URL=
NOFRIES_AUTOTASK_ALLOWED_HOSTS=
NOFRIES_AUTOTASK_USERNAME=
NOFRIES_AUTOTASK_SECRET=
NOFRIES_AUTOTASK_INTEGRATION_CODE=
NOFRIES_AUTOTASK_QUEUE_ID=
NOFRIES_AUTOTASK_SOURCE_ID=
NOFRIES_AUTOTASK_ISSUE_TYPE_ID=
NOFRIES_AUTOTASK_SUBISSUE_TYPE_ID=
NOFRIES_AUTOTASK_STATUS_MAP_JSON=
NOFRIES_AUTOTASK_PRIORITY_MAP_JSON=
NOFRIES_AUTOTASK_PRIORITY_MAP_SHA256=
NOFRIES_AUTOTASK_DEVICE_MAP_JSON={}
NOFRIES_AUTOTASK_OPERATION_UDF_NAME=NoFriesOperationId
# A ticket is customer-visible only when this distinct Autotask UDF has exactly
# the configured JSON primitive value. Company membership alone is insufficient.
NOFRIES_AUTOTASK_PORTAL_VISIBLE_UDF_NAME=
NOFRIES_AUTOTASK_PORTAL_VISIBLE_UDF_VALUE_JSON=
NOFRIES_AUTOTASK_CUSTOMER_VISIBLE_PUBLISH_VALUE=
NOFRIES_AUTOTASK_CUSTOMER_VISIBLE_NOTE_TYPE_ID=
NOFRIES_AUTOTASK_STATUS_WRITES_ENABLED=false
NOFRIES_AUTOTASK_STATUS_WRITER_GOVERNANCE=

# Customer portal and monthly Proof. Memberships bind immutable tid:oid
# subjects to exactly one current lifecycle customer, workspace, provider scope,
# Autotask company and current contact. Before a portal write, Autotask must
# verify that exact contact still belongs to that exact company. Normal hosted
# Proof readiness requires the retained daily scheduler to be healthy; it creates
# internal operator tasks only and never generates, approves or issues Proof.
# Emergency read-only mode stops that scheduler but preserves integrity-checked
# issued Proof reads. The portal publishes only explicitly issued,
# maker/checker-approved statements.
NOFRIES_CUSTOMER_PORTAL_ENABLED=false
NOFRIES_CUSTOMER_PORTAL_WRITES_ENABLED=false
NOFRIES_CUSTOMER_PORTAL_WRITE_SCOPE=disabled
NOFRIES_CUSTOMER_PORTAL_MEMBERSHIPS=
NOFRIES_CUSTOMER_PORTAL_CANARY_SUBJECTS=
NOFRIES_MONTHLY_PROOF_SCHEDULER_ENABLED=false
NOFRIES_MONTHLY_PROOF_INTERVAL_MS=86400000
NOFRIES_MONTHLY_PROOF_HEALTH_MAX_AGE_MS=172800000
# PostgreSQL is an explicit per-module opt-in for the implemented Service Desk
# and Lifecycle slices. Local/CI may use NOFRIES_DATABASE_URL. Hosted production must instead
# use the managed-identity host/database/user settings; URL credentials fail
# closed there. Keep the provider local/azure until migrations and tenant/RLS
# checks have passed in the intended non-production environment.
NOFRIES_DATABASE_URL=
NOFRIES_POSTGRES_HOST=
NOFRIES_POSTGRES_PORT=5432
NOFRIES_POSTGRES_DATABASE=
NOFRIES_POSTGRES_USER=
NOFRIES_POSTGRES_POOL_MAX=10
NOFRIES_POSTGRES_STATEMENT_TIMEOUT_MS=15000
NOFRIES_POSTGRES_CONNECTION_TIMEOUT_MS=5000
NOFRIES_POSTGRES_IDLE_TIMEOUT_MS=30000

# Datto RMM bridge. This shared provider-account bootstrap is reused for every
# accepted customer; each customer still receives a separate lifecycle record,
# marked Datto site, device plan and approval evidence. Keep disabled until the
# dedicated API identity, least-privilege access and customer/site boundaries
# have been reviewed. In controlled_write mode the server exchanges the API
# key/secret for a short-lived OAuth token; credentials and tokens must remain
# in protected runtime settings and must never be sent to the browser or committed.
NOFRIES_DATTO_RMM_MODE=disabled
# Exact No Fries/Entra tenant ID that exclusively owns this Datto account
# binding. All Datto routes fail closed for another tenant.
NOFRIES_DATTO_RMM_TENANT_ID=
NOFRIES_DATTO_RMM_API_URL=
# Required for controlled_write. Do not use an interactive user's password or
# automate the Datto browser sign-in/MFA flow.
NOFRIES_DATTO_RMM_API_KEY=
NOFRIES_DATTO_RMM_API_SECRET=
# Optional legacy compatibility for readonly mode only. Prefer server-side
# token exchange from the dedicated API key/secret.
NOFRIES_DATTO_RMM_ACCESS_TOKEN=
# Platform installer origin used only to create a site-scoped Windows/macOS
# handoff URL. No Fries does not bypass endpoint admin/UAC or macOS TCC prompts.
NOFRIES_DATTO_RMM_INSTALLER_BASE_URL=
# Optional exact hosts for an approved non-centrastage API or installer test
# endpoint. Keep the list as narrow as possible.
NOFRIES_DATTO_RMM_ALLOWED_HOSTS=

# Shared lifecycle context and public prospect assistant. The public agent is bound
# to NOFRIES_DEFAULT_TENANT_ID on the server; a browser cannot select a tenant.
# `postgres` is available only after the numbered migrations and tenant/RLS
# checks have passed. `local` and `azure` remain the operational defaults; there
# is no dual write or automatic import.
NOFRIES_LIFECYCLE_STORAGE_PROVIDER=local
NOFRIES_LIFECYCLE_CONTAINER=nofries-workspace
NOFRIES_PROSPECT_SIGNING_SECRET=
NOFRIES_PROSPECT_AGENT_RUNTIME=mock
NOFRIES_PROSPECT_CREATE_BURST_MAX=3
NOFRIES_PROSPECT_CREATE_BURST_WINDOW_MS=600000
NOFRIES_PROSPECT_CREATE_CLIENT_MAX=8
NOFRIES_PROSPECT_CREATE_CLIENT_WINDOW_MS=86400000
NOFRIES_PROSPECT_CREATE_GLOBAL_HOUR_MAX=30
NOFRIES_PROSPECT_CREATE_GLOBAL_HOUR_WINDOW_MS=3600000
NOFRIES_PROSPECT_CREATE_GLOBAL_DAY_MAX=100
NOFRIES_PROSPECT_CREATE_GLOBAL_DAY_WINDOW_MS=86400000
# Authenticated proposal wording review. Use openai in production after the
# existing server-side OPENAI_API_KEY is configured; mock remains deterministic.
NOFRIES_PROPOSAL_REVIEW_RUNTIME=mock
OPENAI_API_KEY=
NOFRIES_MODEL_PROSPECT=gpt-5.6-luna
NOFRIES_MODEL_SUMMARY=gpt-5.6-luna
NOFRIES_MODEL_SCOPING=gpt-5.6-terra
NOFRIES_MODEL_INVESTIGATION=gpt-5.6-terra

# The public MCP connector requires a verified bearer token by default. These
# opt-ins are only for an explicitly trusted SWA edge or local connector testing.
NOFRIES_MCP_ALLOW_PLATFORM_IDENTITY=false
NOFRIES_MCP_ALLOW_DEVELOPMENT_IDENTITY=false

# Lifecycle retention. The authenticated operator previews and explicitly runs
# the job; linked customers and human-contact escalations are excluded.
NOFRIES_RETENTION_RAW_CONVERSATION_DAYS=90
NOFRIES_RETENTION_ABANDONED_PROSPECT_DAYS=180
NOFRIES_RETENTION_OBSERVABILITY_DAYS=365
NOFRIES_RETENTION_PROSPECT_SECURITY_DAYS=30

# Public email verification for the detailed managed IT service scope.
NOFRIES_SCOPE_STORAGE_PROVIDER=local
NOFRIES_SCOPE_DATA_DIR=.nofries-scope-data
NOFRIES_SCOPE_CONTAINER=nofries-workspace
NOFRIES_SCOPE_SIGNING_SECRET=
NOFRIES_SCOPE_EMAIL_FROM=No Fries <scope@nofries.nz>
NOFRIES_SCOPE_EMAIL_REPLY_TO=hello@nofries.nz
RESEND_API_KEY=

# Optional one-way CRM handoff retained for compatibility. Leave writes disabled
# unless No Fries explicitly configures and approves the destination integration.
NOFRIES_DYNAMICS_FLOW_URL=
NOFRIES_DYNAMICS_SCOPE=
NOFRIES_DYNAMICS_TENANT_ID=
NOFRIES_DYNAMICS_CLIENT_ID=
NOFRIES_DYNAMICS_CLIENT_SECRET=
NOFRIES_DYNAMICS_USE_MANAGED_IDENTITY=false
NOFRIES_DYNAMICS_ALLOW_SIGNED_URL=false
NOFRIES_DYNAMICS_WRITE_ENABLED=false

# Optional first-party aggregate website analytics (disabled by default).
# Requires the existing application-data account and an existing NOFRIES_AZURE_CONTAINER
# (or nofries-workspace), a managed identity with read/write access, and the exact
# NOFRIES_PUBLIC_URL origin. No container is created. Staff summary additionally
# requires the Entra BFF, an explicit default tenant, and the subject in both the
# existing allowed-subject and admin-subject lists. Deploying/enabling this setting
# is an operator action; it is not performed by this repository.
NOFRIES_WEBSITE_ANALYTICS_ENABLED=false
